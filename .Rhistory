df <- read_csv("../../decomp_data/recycling_laa.csv")[,1:6] |> janitor::clean_names()
pop <- read_csv("../../decomp_data/pop_midyear_age_sex_council_areas.csv") |>
janitor::clean_names() |>
filter(year %in% c(2018,2022)) |>
filter(sex=="Persons") |>
transmute(
year,laa=area_name,popmy=all_ages
) |> filter(laa!="Scotland")
df <- df |> transmute(
year,laa=gsub("†","",local_authority),
gen = generated_tonnes,
rec = recycled_tonnes,
pop = gen/recycled_perperson
)
df <- left_join(df,pop) |>
mutate(
rate = rec/gen
)
df |> group_by(year) |>
summarise(
crude = sum(rate*(pop/sum(pop)))
)
names(df)[5:6]<-c("size","sizem")
dgnpop(df, pop="year",factors="rate",id_vars="laa",crossclassified="sizem") |>
dg_table()

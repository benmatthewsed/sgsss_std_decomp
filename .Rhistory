ddat <- read_csv("data/scotland_deaths_1981_2024.csv")
ddat |>
group_by(year) |>
summarise(
crude1 = sum(deaths)/sum(n),
crude2 = sum( (deaths/n) * (n/sum(n)) )
)
ddat <-
ddat |>
mutate(
rate = deaths/n
)
# # takes time..
deaths_dc <- dgnpop(deaths_ddat,
pop = "year",
factors = "rate",
id_vars = c("age","sex"),
crossclassified = "n", quietly = FALSE)
deaths_dc <- dgnpop(ddat,
pop = "year",
factors = "rate",
id_vars = c("age","sex"),
crossclassified = "n", quietly = FALSE)
save(deaths_dc,file="data/deaths_age_sex_full.rdata")
dg_plot(deaths_dc,legend.position="bottom")

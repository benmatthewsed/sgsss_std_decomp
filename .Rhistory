pops <- read_csv("decomp_data/pop_midyear_age_sex_council_areas.csv") |>
janitor::clean_names() |>
filter(area_name!="Scotland") |>
pivot_longer(x0:x90_and_over) |>
mutate(age = parse_number(name)) |>
group_by(year, area_name, area_code, sex) |>
summarise(
x0_19 = sum(value[age<=19]),
x20_24 = sum(value[age>=20 & age<=24]),
x25_29 = sum(value[age>=25 & age<=29]),
x30_34 = sum(value[age>=30 & age<=34]),
x35_39 = sum(value[age>=35 & age<=39]),
x40_and_over = sum(value[age>=40]),
) |>
filter(sex != "Persons") |>
pivot_longer(x0_19:x40_and_over, names_to = "age", values_to="n") |>
mutate(area_name = gsub("h-Eileanan","h Eileanan", area_name))

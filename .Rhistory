#| include: false
df <- read_csv("data/recycling_timeseries.csv")
df <- df |>
mutate(
wpp = totalwaste/pop,
recp = recycled/totalwaste,
lfp = landfilled/totalwaste,
incp = diverted/totalwaste
)
# recycling tonnes per person:
dgnpop(df,
pop="year",
factors=c("wpp","recp")) |>
dg_plot(legend.position="bottom")
# recycling tonnage
dgnpop(df,
pop="year",
factors=c("pop","wpp","recp")) |>
dg_plot(legend.position="bottom")
head(df)
with(df,plot(wpp~year))
with(df,plot(wpp~year,type="b"))
with(df,plot(wpp~year,type="b"))
with(df,plot(recp~year,type="b"))
with(df,plot(recycled~year,type="b"))
# recycling tonnage
dgnpop(df,
pop="year",
factors=c("pop","wpp","recp")) |>
dg_plot(legend.position="bottom")
par(mfrow=c(2,2))
with(df,plot(recp~year,type="b"))
with(df,plot(wpp~year,type="b"))
with(df,plot(pop~year,type="b"))
# recycling tonnage
dgnpop(df,
pop="year",
factors=c("pop","wpp","recp")) |>
dg_plot(legend.position="bottom")
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop),
cr2 = sum(hdr*hr)
)
hd <- read_csv("data/hdeaths.csv")
# decomposing deaths per 1000 people
hd <-
hd |> mutate(
hdr = deaths/applications,
hr = applications/scotpop,
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop),
cr2 = sum(hdr*hr)
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e3,
cr2 = sum(hdr*hr)
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e3,
cr2 = sum(hdr*hr*scotpop/sum(scotpop))
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e3,
cr2 = sum(hdr*hr*scotpop/sum(scotpop))*1e3
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e5,
# as multiplication of factors:
cr2 = sum( hdr * hr * scotpop/sum(scotpop) )*1e5
)
dgres <-
dgnpop(hd,
pop="year",
factors=c("hr","hdr"),
id_vars="age_group",
crossclassified = "scotpop")
dg_plot(dgres)
dgres |> dg_table(2017,2024)
hd <- hd |> group_by(year) |>
summarise(
tpop = sum(scotpop)
)

library(xaringanExtra)
use_panelset()
library(DasGuptR)
# Chunk 2
hd <- read_csv("data/hdeaths.csv")
hd <-
hd |> mutate(
hdr = deaths/homeless,
hr = homeless/scotpop,
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e5,
# as multiplication of factors:
cr2 = sum( hdr * hr * scotpop/sum(scotpop) )*1e5
)
dgres <-
dgnpop(hd,
pop="year",
factors=c("hr","hdr"),
id_vars="age_group",
crossclassified = "scotpop",
ratefunction = "hr*hdr*1e5")
dg_plot(dgres, legend.position="bottomright")
dgres |> dg_table(2017,2024)
# Chunk 4
hd <- hd |> group_by(year) |>
mutate(
tpop = sum(scotpop)
)
dgres2 <-
dgnpop(hd,
pop="year",
factors=c("hr","hdr","tpop"),
id_vars="age_group",
crossclassified = "scotpop")
dg_plot(dgres2, legend.position="bottomright")
dgres |> dg_table(2017,2024)
# Chunk 5
df <- read_csv("data/recycling_timeseries.csv")
df <- df |>
mutate(
wpp = totalwaste/pop,
recp = recycled/totalwaste,
lfp = landfilled/totalwaste,
incp = diverted/totalwaste
)
# recycling tonnes per person:
dgnpop(df,
pop="year",
factors=c("wpp","recp")) |>
dg_plot(legend.position="bottom")
# recycling tonnage
dgnpop(df,
pop="year",
factors=c("pop","wpp","recp")) |>
dg_plot(legend.position="bottom")
# Chunk 6
gdat <- read_csv("data/gender_pay_occ.csv")
# crude GPayGap:
# female median as a percentage of male median
gdat |>
group_by(sex) |>
summarise(
mean = sum( mean_hourly * thousand/sum(thousand) ),
) |> pivot_wider(names_from=sex,values_from=mean) |>
mutate(
pgap = (1-(female/male))*100
)
# occupation-adjusted GPayGap:
dgnpop(gdat,
pop = "sex",
factors = "mean_hourly",
id_vars = "soc2dcode",
crossclassified = "thousand") |>
filter(factor == "mean_hourly") |>
select(pop,rate,factor) |>
pivot_wider(names_from=pop,values_from=rate) |>
mutate(
pgap = (1-(female/male))*100
)
# Chunk 7
egen <- read_csv("data/elec_gen.csv")
egen <- egen |>
mutate(
total_gen = total_generation,
total_imp = net_imports,
pfossil = fossil/total_gen,
pclean = clean/total_gen,
prenew_clean = renewables/clean,
pws_ren = wind_and_solar/renewables,
) |> mutate(across(4:last_col(),~ifelse(is.na(.),0,.)))
egen |>
filter(year>=2012,year<=2022) |>
dgnpop(pop="year",
factors=c("pws_ren","prenew_clean","pclean"),
id_vars="country",
crossclassified = "total_gen") -> eres
dg_plot(eres, legend.position="topleft")
# within a subgroup
egen |>
filter(grepl("United Kingdom",country)) |>
dgnpop(pop="year",
factors=c("pws_ren","prenew_clean","pclean")) -> eresuk
dg_plot(eresuk, legend.position="topleft")
# Chunk 8
ecap <- read_csv("data/elec_cap.csv")
ecap <- ecap |>
mutate(
country,year,
total = clean+fossil,
pfossil = fossil/total,
pclean = clean/total,
prenew_clean = renewables/clean,
pws_ren = wind_and_solar/renewables,
) |> mutate(across(3:last_col(),~ifelse(is.na(.),0,.)))
ecap |>
filter(grepl("United Kingdom",country)) |>
dgnpop(pop="year",
factors=c("pws_ren","prenew_clean","pclean")) -> erescapuk
dg_plot(erescapuk, legend.position="topleft")
# Chunk 9
left_join(
ecap |> transmute(country,year,fcap=fossil,tcap=total),
egen |> transmute(country,year,fgen=fossil)
) |>
mutate(
ftcap = fcap/tcap,
fgc = fgen/fcap
) |>
filter(grepl("United States",country)) |>
dgnpop(pop="year",factors=c("fgc","ftcap","tcap")) |>
dg_plot()
# Chunk 10
bs <- read_csv("data/businesssurvival.csv") |>
mutate(
a = surv5/surv3,
b = surv3/surv1,
c = surv1/births,
) |>
group_by(cohort) |>
mutate(iprop = births/sum(births))
bs |> group_by(cohort) |>
summarise(
crude = sum(surv5)/sum(births),
crude2= sum(c*b*a*iprop)
)
dgnpop(bs, pop="cohort",
factors=c("a","b","c","iprop"),
ratefunction = "sum(a*b*c*iprop)") |> dg_plot()
dgnpop(bs, pop="cohort",
factors=c("a","b","c"),
id_vars="industry",
crossclassified="births") |> dg_plot()
head(bs)
# Chunk 11
hdat <- read_csv("data/heroin.csv")
hdat$totpop <- ave(hdat$pop, hdat$year, FUN=sum)
hdat <- hdat |>
mutate(
hr = nheroin/ndeaths,
ddr = ndeaths/pop
)
hdat |> group_by(year) |>
summarise(
crude = sum(nheroin),
crude2 = sum(hr * ddr * (pop/totpop) * totpop )
)
dgnpop(hdat,
pop="year",
factors=c("hr","ddr", "totpop"),
id_vars = c("agegroup","sex"),
crossclassified = "pop") |>
dg_plot(legend.position="bottom")

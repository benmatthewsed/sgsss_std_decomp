uscity <-
tribble(
~population, ~total_events, ~nr_propcrime, ~nr_burglary,
"springfield illinois", 5844.68/1e5*111965, 4911.36/1e5*111965, 1524.58/1e5*111965,
"hillsboro oregon", 2778.34/1e5*107978, 2429.2/1e5*107978, 174.11/1e5*107978
) |> mutate(across(2:last_col(),round))
uscity <-
tribble(
~population, ~total_events, ~nr_propcrime, ~nr_burglary,
"springfield illinois", 5844.68/1e5*111965, 4911.36/1e5*111965, 1524.58/1e5*111965,
"hillsboro oregon", 2778.34/1e5*107978, 2429.2/1e5*107978, 174.11/1e5*107978
) |> mutate(across(2:last_col(),round)) |>
mutate(
Burg_Rate = nr_burglary/total_evens
)

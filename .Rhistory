### deaths
deaths <-
read_csv("../../decomp_data/deaths_age_sex.csv") |>
janitor::clean_names() |>
select(-all_ages,-not_stated) |>
pivot_longer(x0:last_col(), names_to="age",values_to="n") |>
mutate(age = parse_number(age),
age = ifelse(age>90,90,age)) |>
filter(sex != "Persons") |>
group_by(year,age,sex) |>
summarise(deaths = sum(n))
pops <- read_csv("../../decomp_data/pop_midyear_age_sex_council_areas.csv") |>
janitor::clean_names() |>
filter(area_name!="Scotland", sex != "Persons") |>
pivot_longer(x0:x90_and_over) |>
mutate(age = parse_number(name)) |>
group_by(year, age, sex) |>
summarise(
n = sum(value)
)
deaths_ddat <- left_join(pops, deaths) |>
filter(year %in% c(1991,2000,2010,2020)) |>
mutate(
age = cut(age, 10)
) |> group_by(year,age,sex) |>
summarise(
n = sum(n),deaths=sum(deaths),
rate = deaths/n*1e3
)
deaths_ddat <- left_join(pops, deaths) |>
filter(year %in% c(1991,2000,2010,2024)) |>
mutate(
age = cut(age, 10)
) |> group_by(year,age,sex) |>
summarise(
n = sum(n),deaths=sum(deaths),
rate = deaths/n*1e3
)

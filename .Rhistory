clogg_long <- read_csv("https://raw.githubusercontent.com/benmatthewsed/sgsss_std_decomp/refs/heads/main/data/example2-clogg-long.csv")
original_res <-
DasGuptR::dgnpop(
clogg_long,
pop = "parity",
factors = c("rate"),
id_vars = "age_groups",
crossclassified = "size") |>
DasGuptR::dg_table()
original_res
clogg_uncount <-
clogg_long |>
uncount(size, .remove = FALSE) |> # we need to keep the size variable so set .remove as FALSE
group_by(age_groups, parity) |>
mutate(
d = as.integer(row_number() <= round(rate * size / 100))
) |>
ungroup()
clogg_uncount
dg_clogg <- function(clogg_df){
DasGuptR::dgnpop(
clogg_df,
pop = "parity",
factors = c("rate"),
id_vars = "age_groups",
crossclassified = "size") |>
DasGuptR::dg_table() |>
rownames_to_column() # this will be helpful later!
}
agg_clogg <- function(splits){
rsample::analysis(splits) |>
count(age_groups, parity, d, name = "size") |> # this is the opposite of uncount()
pivot_wider(names_from = "d", # turns the dataset wider to make the next step easier
values_from = "size") |>
mutate(size = `1` + `0`,
rate = `1` / size * 100) |>
select(age_groups, parity, size, rate) # keep only the columns we need
}
clogg_straps <-
rsample::bootstraps(
clogg_uncount, times = 100
)
clogg_straps
clogg_straps <-
clogg_straps |>
mutate(clogg_agg = map(splits, agg_clogg))
clogg_straps <-
clogg_straps |>
mutate(results = map(clogg_agg, dg_clogg))
clogg_straps
clogg_straps |>
mutate(results = map(clogg_agg, dg_clogg)) |>
select(id, results) |>
unnest(results)
clogg_boot_res <-
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname) |>
summarise(se_diff = sd(diff))
clogg_boot_res
original_res |>
rownames_to_column() |>
left_join(clogg_boot_res) |>
mutate(conf_low = diff - 1.96 * se_diff,
conf_upp = diff + 1.96 * se_diff)
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname) |>
summarise(estimate = quantile(diff, c(0.025, 0.5, 0.975), na.rm = TRUE),
ci = c(0.025, 0.5, 0.975)) |>
pivot_wider(id_cols = rowname,
names_from = ci,
values_from = estimate)
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname)
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname) |>
summarise(estimate = quantile(diff, c(0.025, 0.5, 0.975), na.rm = TRUE),
ci = c(0.025, 0.5, 0.975))
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname) |>
reframe(estimate = quantile(diff, c(0.025, 0.5, 0.975), na.rm = TRUE),
ci = c(0.025, 0.5, 0.975))
clogg_straps |>
select(id, results) |>
unnest(results) |>
# filter(is.na(diff))
group_by(rowname) |>
reframe(
estimate = quantile(diff, c(0.025, 0.5, 0.975), na.rm = TRUE),
ci = c(0.025, 0.5, 0.975)
) |>
pivot_wider(id_cols = rowname,
names_from = ci,
values_from = estimate)
library(tidyverse)
library(DasGuptR)
df <- read_csv("https://josiahpjking.github.io/sgsss_std_decomp/data/recycling_timeseries.csv")
df <- df |>
mutate(
wpp = totalwaste/pop,
recp = recycled/totalwaste,
lfp = landfilled/totalwaste,
incp = diverted/totalwaste
)
# recycling tonnes per person:
dgnpop(df,
pop="year",
factors=c("wpp","recp")) |>
dg_plot(legend.position="bottom")
# recycling tonnage
dgnpop(df,
pop="year",
factors=c("pop","wpp","recp")) |>
dg_plot(legend.position="bottom")
# with just 2 years:
dgnpop(df |> filter(year %in% c(2011,2022)),
pop="year",
factors=c("wpp","recp")) |>
dg_table()
dgnpop(df,
pop="year",
factors=c("wpp","recp")) |>
dg_table()
dgnpop(df,
pop="year",
factors=c("wpp","recp")) |>
dg_table(pop1 = 2011, pop2 = 2022)
# with just 2 years:
dgnpop(df |> filter(year %in% c(2011,2016)),
pop="year",
factors=c("wpp","recp")) |>
dg_table()

library(tidyverse)
library(tidyverse)
hd <- read_csv("data/hdeaths.csv")
hd <-
hd |> mutate(
hdr = deaths/homeless,
hr = homeless/scotpop,
)
#crude rates
hd |>
group_by(year) |>
summarise(
cr = sum(deaths)/sum(scotpop)*1e5,
# as multiplication of factors:
cr2 = sum( hdr * hr * scotpop/sum(scotpop) )*1e5
)
work25 <- data.frame(
pop = c("males","females"),
working_age = c(23718900, 24613110),
labour_force = c(18442860, 5767405),
employees = c(4823169, 280557),
avg_hours_pp = c(37.9, 31.7),
total_weekly_earnings = c(4240916038, 178762504)
)
# crude rates
work25 |> transmute(
pop,
weeklyearnings_perperson = total_weekly_earnings/working_age
)
# create factors
work25 <-
work25 |>
mutate(
participation = labour_force / working_age,
employment = employees / labour_force,
hours = avg_hours_pp,
earnings = total_weekly_earnings/hours/employees
)
# decompose
dgnpop(work25,
pop="pop",
factors=c("participation","employment","hours","earnings")) |>
dg_table()

set.seed(888)
df = eg5.3
df$size = round(rnorm(nrow(df), df$age*30+df$race*20+df$age*df$race*50,10))
df$rate = rnorm(nrow(df),df$size*.03,5)
df <- df |> group_by(pop) |>
  mutate(
    agerace = interaction(age,race),
    agerace_w = size/sum(size),
    .after = race
  ) |> ungroup()
eg5.3<-df

eg5.3 <- 
  eg5.3 |> 
  mutate(
    age_w = with(eg5.3, ave(size, pop, age, FUN = sum)) /
      with(eg5.3, ave(size, pop, FUN = sum)),
    race_w = with(eg5.3, ave(size, pop, race, FUN = sum)) /
      with(eg5.3, ave(size, pop, FUN = sum)),
    .after = agerace_w
  )


dgnpop(x = eg5.3,
       pop = "pop",
       factors = c("age_w","race_w","rate"),
       ratefunction = "sum(age_w * race_w * rate)") |>
  dg_table() -> dd

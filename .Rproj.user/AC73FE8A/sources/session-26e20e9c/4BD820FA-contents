library(tidyverse)
library(DasGuptR)
df <- reconv |> filter(year %in% c(2010,2016)) |>
  mutate(
    rate = prev_rate,
    agesex = interaction(Age,Sex),
  )

df$weight <- df$offenders/ave(df$offenders,df$year,FUN=sum)
dgnpop(df, 
       pop="year",
       factors=c("weight","rate"),
       ratefunction="sum(weight * rate)") |>
  dg_table()

dgnpop(df, 
       pop="year",
       factors=c("rate"),
       id_vars=c("agesex"),
       crossclassified = "offenders") |>
  dg_table()


df$weight_sex <- ave(df$offenders,df$year,df$Sex,FUN=sum)/
  ave(df$offenders,df$year,FUN=sum)
df$weight_age <- ave(df$offenders,df$year,df$Age,FUN=sum)/
  ave(df$offenders,df$year,FUN=sum)

dgnpop(df, 
       pop="year",
       factors=c("rate","weight_sex","weight_age"),
       ratefunction="sum(weight_sex*weight_age*rate)") |>
  dg_table()


dgnpop(df, 
       pop="year",
       factors=c("rate"),
       id_vars=c("Age","Sex"),
       crossclassified = "offenders") |>
  dg_table()

opt_dg <- rbind(
  split_popstr(df[df$year==2004, ],c("Age","Sex"),"offenders"),
  split_popstr(df[df$year==2016, ],c("Age","Sex"),"offenders")
)

bind_cols(df, opt_dg) |>
  group_by(year) |>
  summarise(
    crude = sum(reconvicted)/sum(offenders),
    opt1 = sum(weight * rate),
    # missing a bit!! 
    opt2 = sum(weight_sex*weight_age*rate),
    # opt DG
    optdg = sum(Age_struct*Sex_struct*rate)
  )





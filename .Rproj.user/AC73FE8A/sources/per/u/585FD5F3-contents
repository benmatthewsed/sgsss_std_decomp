library(tidyverse)
library(DasGuptR)
# for das gupta:
tribble(
    ~country, ~n_people, ~n_, ~n_births,
    "Scotland", 10, 5, 3,
    "England", 20, 4, 3,
  )  |>
  mutate(
    proppo = n_po/n_people,
    bppo  = n_births/n_po
  ) |> dgnpop(pop = "country",
       factors=c("proppo","bppo")) |> dg_table()


# for regression methods: 
tribble(
  ~country, ~person, ~po, ~birth,
  "Scotland", rep(1,10), sample(rep(0:1,5)), sample(rep(0:1,times=c(7,3))),
  "England", rep(1,20), sample(rep(0:1,c(16,4))), sample(rep(0:1,times=c(17,3))),
) |> unnest()


lm(birth~po*country,df) |> summary()


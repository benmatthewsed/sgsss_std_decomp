  mutate(
    `births / w15-44 * 1000` = round(n_births/n_women15to44*1000,3),
    `w15-44 / people` = round(n_women15to44/n_people,3),
    birth_rate = round(`births / w15-44 * 1000`*`w15-44 / people`,2)
  ) |> gt::gt()
```


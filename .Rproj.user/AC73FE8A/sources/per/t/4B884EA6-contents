::: {.callout-note collapse="true"}
#### Scotland's Business 5 year Survival Rate


$$ \small
\begin{align} 
\text{5 year survival rate} &= \frac{\text{Nr Survived after 5yrs}}{\text{Nr Established}} \\
\quad \\
\text{5 year survival rate} &= \sum\limits_{\text{sector }i}\frac{\text{Nr Established}_i}{\text{Nr Established}} \cdot \frac{\text{Nr Survived 1yr}_i}{\text{Nr Established}_i} \cdot \frac{\text{Nr Survived 3yr}_i}{\text{Nr Survived 1yr}_i} \cdot \frac{\text{Nr Survived 5yr}_i}{\text{Nr Survived 3yr}_i}
\end{align}
$$

:::
`r solbegin(show=params$SHOW_SOLS, toggle=params$TOGGLE)`
```{r}
bs <- read_csv("data/businesssurvival.csv") |> 
  mutate(
    a = surv5/surv3,
    b = surv3/surv1,
    c = surv1/births,
  ) |> 
  group_by(cohort) |>
  mutate(iprop = births/sum(births))

bs |> group_by(cohort) |>
  summarise(
    crude = sum(surv5)/sum(births),
    crude2= sum(c*b*a*iprop)
  )


dgnpop(bs, pop="cohort",
       factors=c("a","b","c","iprop"),
       ratefunction = "sum(a*b*c*iprop)") |> dg_plot()

dgnpop(bs, pop="cohort",
       factors=c("a","b","c"),
       id_vars="industry",
       crossclassified="births") |> dg_plot()

head(bs)
```


`r solend()`






@misc{trajtenbergRethinkingCrossNationalCybercrime2026,
  title = {Rethinking {{Cross-National Cybercrime Comparisons}}: {{A Network Analysis}} of {{Survey-Based Victimization Indicators}}},
  shorttitle = {Rethinking {{Cross-National Cybercrime Comparisons}}},
  author = {Trajtenberg, Nico and Ezquerra, Pablo and {Buil-Gil}, David},
  year = 2026,
  month = jun,
  journal = {CrimRxiv},
  doi = {10.21428/cb6ab371.eb347fbb},
  urldate = {2026-06-15},
  abstract = {The expansion of digital economies and cross-border online harms creates a growing need for reliable cross-national cybercrime comparisons. Yet such comparisons remain difficult because official crime data are recorded inconsistently across countries. Researchers increasingly rely on victimization surveys to assess cybercrime risk cross-nationally, but using surveys rests on a strong and often implicit assumption: cybercrime victimization can be meaningfully captured as a coherent and comparable construct. In practice, cross-national studies employ diverse measurement strategies, including single-item indicators and composite indices that combine multiple victimization experiences. While single-item measures may suffer from limited reliability and content validity, composite indices treat heterogeneous victimization experiences as interchangeable components of broader constructs. Composite indices may hide differences in the connectivity, clustering, and pathways linking different forms of victimization across countries with distinct digital infrastructures, regulatory environments, and socio-economic contexts. To assess the coherence and comparability of composite measures of cybercrime victimization, we apply a network-analytic framework to Eurobarometer 2019 data (28 countries; n=21,196). We model cyber-enabled (e.g., consumer fraud, identity theft), cyber-dependent (e.g., malware, hacking), and accidental exposure (e.g., child sexual abuse, hate) harms as a system of interconnected experiences rather than interchangeable indicators of a latent construct. Country-specific networks are estimated using Ising models and compared using the Network Comparison Test to identify cross-national differences in connectivity, clustering, and bridge pathways. Results show that cybercrime victimization is not structured uniformly cross-nationally and shows both shared and country-specific features. Some countries exhibit dense and highly interconnected networks in which victimization experiences strongly co-occur, while others display more fragmented structures with weaker associations between experiences. Identity theft and fraud emerge as highly connected nodes, but no universal organizing center is observed. The structure of cybercrime victimization varies across countries, suggesting that cybercrime victimization cannot be assumed to represent a fully comparable construct across national contexts.},
  langid = {english}
}


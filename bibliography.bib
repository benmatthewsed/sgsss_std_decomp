@incollection{buchanYouthJusticeSystem2025,
  title = {The Youth Justice System in {{Scotland}}},
  booktitle = {Criminal {{Justice}} in {{Scotland}}},
  author = {Buchan, Jamie and Anderson, Sarah and Morrison, Katrina},
  year = 2025,
  publisher = {Routledge},
  abstract = {Scotland's approach to youth justice is unique, underpinned by the `Kilbrandon philosophy' -- the idea that children who offend should be treated the same as any other children with unmet welfare needs. The Kilbrandon Report led to the creation of a system of `children's hearings'--panels of volunteers which aim to address young people's offending alongside other child welfare issues. However, the Kilbrandon philosophy is challenging to realise in practice, particularly since hearings operate within a wider context of traditional justice and punishment-focused agencies and processes. This chapter examines youth justice policies since devolution: a brief and incomplete convergence with the English/Welsh `antisocial behaviour' agenda, followed by a shift towards diversion to reduce the number of children affected by the system. More recently, the emphasis has shifted towards protecting children's rights and mitigating childhood trauma. Substantial work is needed to realise these ambitions but has already resulted in the important step of ending the imprisonment of children in Scotland.}
}


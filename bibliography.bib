  shorttitle = {The {{Drop}} in {{Juvenile Delinquency}} in {{The Netherlands}}},
  author = {{van der Laan}, Andr{\'e} M. and Rokven, Josja and Weijters, Gijs and Beerthuizen, Marinus G.C.J.},
